___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const createQueue = require('createQueue');
const setInWindow = require('setInWindow');
//const getUrl = require('getUrl');
const logToConsole = require('logToConsole');

// Get the StackAdapt ID from template field
const stackAdaptId = data.stackAdaptId;
const stackAdaptScriptUrl = data.stackAdaptScriptUrl;

// Create the saq function and queue
const saqQueue = createQueue('saq');

// Set up the saq function in window
setInWindow('saq', function() {
  saqQueue(arguments);
}, false);

// Set additional properties on the saq function
setInWindow('saq.push', function() {
  saqQueue(arguments);
}, false);

setInWindow('saq.loaded', true, false);
setInWindow('saq.version', data.stackAdaptVersion , false);
setInWindow('saq.queue', [], false);

// Function to initialize StackAdapt tracking
const initializeStackAdapt = () => {
  const saq = require('callInWindow');
  saq('saq', 'ts', stackAdaptId);
};

// Inject the StackAdapt script
const onSuccess = () => {
  logToConsole('StackAdapt script loaded successfully');
  initializeStackAdapt();
  data.gtmOnSuccess();
};

const onFailure = () => {
  logToConsole('Failed to load StackAdapt script');
  data.gtmOnFailure();
};

// Inject the script with callbacks
injectScript(stackAdaptScriptUrl, onSuccess, onFailure, 'stackAdaptScript');


